<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/tv_bg</item>
        <item name="android:colorAccent">@color/tv_focus</item>
        <item name="android:navigationBarColor">#090D13</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="TvActionButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/tv_button</item>
        <item name="android:textColor">@color/tv_button_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
