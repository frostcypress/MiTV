<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_disabled" />
            <stroke android:width="1dp" android:color="#46505D" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_focus" />
            <stroke android:width="3dp" android:color="@color/tv_focus_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#F6A000" />
            <stroke android:width="3dp" android:color="@color/tv_focus_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button" />
            <stroke android:width="1dp" android:color="@color/tv_button_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
